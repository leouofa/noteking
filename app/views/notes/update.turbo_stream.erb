<%= turbo_stream.update "rendered_markdown_container" do %>
  <% if @note.body.present? %>
    <%= render_markdown(@note.body) %>
  <% else %>
    <div class="text-neutral-500 italic text-sm py-8 text-center font-mono">
      (Empty note body. Click "Edit" or "Split" above to start writing.)
    </div>
  <% end %>
<% end %>

<%= turbo_stream.replace "note_version_badge" do %>
  <%= link_to note_versions_path(@note),
              id: "note_version_badge",
              title: "View version history",
              class: "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-mono bg-neutral-800 hover:bg-neutral-700 text-neutral-300 hover:text-white border border-neutral-700/60 transition" do %>
    <span>v<%= @note.current_version_number %></span>
  <% end %>
<% end %>

<%= turbo_stream.replace "note_history_button" do %>
  <%= link_to note_versions_path(@note),
              id: "note_history_button",
              title: "Version history and diffs",
              class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-neutral-800 hover:bg-neutral-700 text-neutral-300 hover:text-white border border-neutral-700/60 shadow-sm transition active:scale-95 cursor-pointer" do %>
    <svg class="w-3.5 h-3.5 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>History (v<%= @note.current_version_number %>)</span>
  <% end %>
<% end %>
